<Window x:Class="PullReqInfoCollector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PullReqInfoCollector" 
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Title="MainWindow" Height="800" Width="900">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="1" />
        </Style>
    </Window.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 起動時MSアカウントログイン画面 -->
        <Grid x:Name="WebViewArea" Margin="0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <wpf:WebView2 x:Name="webView2" />
            <Button Grid.Row="1" Content="ログイン完了したらここを押してください" Foreground="Red" Click="Button_Click_1"/>
        </Grid>
        
        <!-- プルリクコメント検索エリア -->
        <Grid Grid.Row="0" x:Name="PullReqCommentSearchArea" Visibility="Collapsed" Margin="0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 検索結果表示リストボックス -->
                <ListBox x:Name="lbThread" Grid.Row="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="String">
                            <TextBlock>
                            <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                                <TextBlock Text="{Binding DisplayString}" />
                            </Hyperlink>
                        </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="tbSearchWord1" Grid.Row="0" Text="aaaaaaaaa"/>
                    <TextBox x:Name="tbSearchWord2" Grid.Row="1"/>
                    <TextBox x:Name="tbSearchWord3" Grid.Row="2"/>

                    <Button Grid.RowSpan="3" Grid.Column="1" x:Name="btGetInfo"  Content="プルリクコメント検索" Click="Button_Click" IsEnabled="False"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 共通エリア(リポジトリ等の情報エリア) -->
        <Grid Grid.Row="1">
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Text="Organization名"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbOrganizationName" Text="tera1707"/>

                <TextBlock Grid.Row="1" Text="Project名"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="tbProjectName" Text="TeraPrivateProject"/>

                <TextBlock Grid.Row="2" Text="自分のメールアドレス"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="tbSelfMailAddr" Text="tera1707@gmail.com"/>

                <CheckBox Grid.Row="4" x:Name="cbAllDisp" Content="担当外・Close済みも表示" IsChecked="True"/>
                <Button Grid.Row="4" Grid.Column="1" Content="設定保存" Click="Button_Click_2" />
            </Grid>

        </Grid>
    </Grid>
</Window>
